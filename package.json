{
  "name": "dues",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.5",
  "scripts": {
    "dev": "bun --bun next dev",
    "build": "rm -f tsconfig.tsbuildinfo && bun --bun next build && bun run build:worker",
    "build:worker": "bun build worker/index.ts scripts/start-web.ts --target=bun --outdir=dist --external=pg-native",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --pool=threads",
    "test:compose": "bash scripts/compose-smoke.sh",
    "db:generate": "drizzle-kit generate",
    "worker": "bun worker/index.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "next": "16.4.6",
    "pg": "8.23.1",
    "pg-boss": "12.38.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
